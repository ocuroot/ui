package main

import (
    "github.com/ocuroot/ui/components/buttons"
    "github.com/ocuroot/ui/components/layout"
)

var red string = "#ff0000"

css header() {
    color: { red };
}

templ Showcase() {
    @ShowcaseLayout("showcase", "UI Showcase", "This is a showcase of the UI components.") {
            <div id="test">
                @layout.Row() {
                    @layout.Column() {
                        <h2>Left side</h2>
                        <div>Left</div>
                    }
                    @layout.Sidebar() {
                        <h2>Right side</h2>
                        <div>Right</div>
                    }
                }
            </div>
            <div id="buttons">
                <h2>Button Components</h2>
                @buttons.Button() {
                    Button
                }
            </div>
    }
}

templ SocialCardShowcase() {
    @SocialCardLayout("social-card", "Social Card Example", "Demonstrating social media card metadata") {
        <div class="space-y-6">
            <div class="bg-gray-50 p-4 rounded-lg">
                <h2 class="text-lg font-semibold mb-2">Social Card Metadata</h2>
                <p class="text-gray-600 mb-4">
                    This page demonstrates how social card metadata is automatically generated. 
                    View the page source to see the OpenGraph and Twitter Card meta tags.
                </p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                        <h3 class="font-medium mb-2">OpenGraph Tags Generated:</h3>
                        <ul class="space-y-1 text-gray-600">
                            <li>• og:title</li>
                            <li>• og:description</li>
                            <li>• og:image</li>
                            <li>• og:image:alt</li>
                            <li>• og:type</li>
                            <li>• og:site_name</li>
                            <li>• og:url</li>
                        </ul>
                    </div>
                    
                    <div>
                        <h3 class="font-medium mb-2">Twitter Card Tags Generated:</h3>
                        <ul class="space-y-1 text-gray-600">
                            <li>• twitter:card</li>
                            <li>• twitter:title</li>
                            <li>• twitter:description</li>
                            <li>• twitter:image</li>
                            <li>• twitter:image:alt</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="bg-blue-50 p-4 rounded-lg">
                <h3 class="font-medium mb-2">Test Social Sharing</h3>
                <p class="text-sm text-gray-600 mb-3">
                    Test your social card previews locally using these methods:
                </p>
                
                <div class="space-y-3">
                    <div>
                        <h4 class="font-medium text-sm mb-1">Option 1: Browser Extension (Recommended)</h4>
                        <div class="text-xs text-gray-600 space-y-1">
                            <p>1. Install "Social Share Preview" browser extension</p>
                            <p>2. Visit this page: <code class="bg-white px-1 rounded">http://localhost:8080/social-card</code></p>
                            <p>3. Click the extension icon to see live social card previews</p>
                            <p class="text-green-600">✓ Works with localhost - no tunneling required</p>
                        </div>
                    </div>
                    
                    <div>
                        <h4 class="font-medium text-sm mb-1">Option 2: View Page Source</h4>
                        <div class="text-xs text-gray-600 space-y-1">
                            <p>1. Right-click → "View Page Source"</p>
                            <p>2. Search for <code class="bg-white px-1 rounded">og:</code> and <code class="bg-white px-1 rounded">twitter:</code> tags</p>
                            <p>3. Verify all meta tags are correctly populated</p>
                        </div>
                    </div>
                    
                    <div>
                        <h4 class="font-medium text-sm mb-1">Option 3: cURL Command</h4>
                        <code class="block mt-1 p-2 bg-white rounded text-xs font-mono">
                            curl -s localhost:8080/social-card | grep -E "(og:|twitter:)"
                        </code>
                    </div>
                </div>
                
                <div class="mt-3 p-2 bg-yellow-50 rounded text-xs">
                    <strong>Online Validation Tools:</strong> Facebook Sharing Debugger, Twitter Card Validator, LinkedIn Post Inspector (require public URLs)
                </div>
            </div>
        </div>
    }
}
